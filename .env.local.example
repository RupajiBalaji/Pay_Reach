# ============================================================================
# PayReach Environment Variables
# ============================================================================

# 1. Anthropic API Key (for real LLM reasoning in the AI Decision Engine)
# Get your API key at: https://console.anthropic.com/
# If omitted or invalid, PayReach gracefully uses the deterministic rule-based fallback model.
ANTHROPIC_API_KEY=sk-ant-api03-...

# 2. Razorpay Test Mode Credentials (for live payment link generation)
# Get your test keys at: https://dashboard.razorpay.com/app/keys
# If omitted, PayReach generates authentic test link previews without errors.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
